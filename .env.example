# Postgres local (docker compose)
POSTGRES_USER=precios
POSTGRES_PASSWORD=precios_dev
POSTGRES_DB=precios
POSTGRES_PORT=5432

# Unica variable que cambia el dia que la base se mude a un host remoto
DATABASE_URL=postgres://precios:precios_dev@localhost:5432/precios

# Avisos del refresco automatico (opcional: sin esto corre igual, en silencio).
# El token lo da @BotFather; el chat id, @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: URL de un monitor externo (healthchecks.io) que avise si el
# refresco deja de correr. Sin esto, el refresco funciona igual.
HEALTHCHECK_URL=
